<Window x:Class="MRC.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:runtime="clr-namespace:MRC.Core.Runtime;assembly=MRC.Core"
        Title="Main Runner Control"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14"
        Foreground="#F4F7FA"
        FontFamily="Cascadia Mono, Consolas">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0E141B" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#121B24" />
        <SolidColorBrush x:Key="BorderBrush" Color="#25313D" />
        <SolidColorBrush x:Key="LabelBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#AAB6C3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667381" />
        <SolidColorBrush x:Key="RunnerBrush" Color="#35D9FF" />
        <SolidColorBrush x:Key="RepositoryBrush" Color="#6BE6FF" />
        <SolidColorBrush x:Key="MetadataBrush" Color="#74A9D8" />
        <SolidColorBrush x:Key="CountBrush" Color="#C792EA" />
        <SolidColorBrush x:Key="IdleBrush" Color="#39E58C" />
        <SolidColorBrush x:Key="BusyBrush" Color="#FFD166" />
        <SolidColorBrush x:Key="OffBrush" Color="#FF5C6C" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A3D" />
        <SolidColorBrush x:Key="StartingBrush" Color="#4CA7FF" />
        <SolidColorBrush x:Key="StoppingBrush" Color="#B48CFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#14202A" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#142C3D" />

        <ControlTemplate x:Key="TerminalButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="{TemplateBinding Padding}"
                                  RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="TerminalButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource TerminalButtonTemplate}" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource RunnerBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BulkOnButtonStyle" TargetType="Button" BasedOn="{StaticResource TerminalButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource IdleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource IdleBrush}" />
        </Style>
        <Style x:Key="BulkOffButtonStyle" TargetType="Button" BasedOn="{StaticResource TerminalButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource OffBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OffBrush}" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="RunnerControlButtonStyle" TargetType="Button" BasedOn="{StaticResource TerminalButtonStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}">
                    <Setter Property="Foreground" Value="{StaticResource OffBrush}" /><Setter Property="BorderBrush" Value="{StaticResource OffBrush}" /><Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}">
                    <Setter Property="Foreground" Value="{StaticResource IdleBrush}" /><Setter Property="BorderBrush" Value="{StaticResource IdleBrush}" /><Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}">
                    <Setter Property="Foreground" Value="{StaticResource BusyBrush}" /><Setter Property="BorderBrush" Value="{StaticResource BusyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /><Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" /><Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STARTING}">
                    <Setter Property="Foreground" Value="{StaticResource StartingBrush}" /><Setter Property="BorderBrush" Value="{StaticResource StartingBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STOPPING}">
                    <Setter Property="Foreground" Value="{StaticResource StoppingBrush}" /><Setter Property="BorderBrush" Value="{StaticResource StoppingBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunnerMoreButtonStyle" TargetType="Button" BasedOn="{StaticResource RunnerControlButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}">
                    <Setter Property="Visibility" Value="Visible" /><Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowItemStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Focusable" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SelectedBrush}" /><Setter Property="BorderBrush" Value="{StaticResource RunnerBrush}" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateForegroundStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}"><Setter Property="Foreground" Value="{StaticResource IdleBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}"><Setter Property="Foreground" Value="{StaticResource BusyBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}"><Setter Property="Foreground" Value="{StaticResource OffBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STARTING}"><Setter Property="Foreground" Value="{StaticResource StartingBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STOPPING}"><Setter Property="Foreground" Value="{StaticResource StoppingBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootSurface" Background="{StaticResource BackgroundBrush}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- terminal identity -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MAIN RUNNER CONTROL" FontSize="24" FontWeight="Bold" Foreground="{StaticResource LabelBrush}" />
                    <TextBlock Text="  //  " FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="BoundaryValue" Text="[AUTHORIZED]" FontSize="13" FontWeight="Bold" Foreground="{StaticResource IdleBrush}" VerticalAlignment="Center" />
                    <Ellipse x:Name="BoundaryDot" Width="7" Height="7" Fill="{StaticResource IdleBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="HOST " Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="MachineValue" Foreground="{StaticResource RunnerBrush}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="   |   ROOT " Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="RootValue" Foreground="{StaticResource MetadataBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="VersionValue" Grid.Column="1" Text="PRE-CERT" Foreground="{StaticResource CountBrush}" FontSize="11" VerticalAlignment="Top" Margin="12,3,0,0" />
        </Grid>

        <!-- compact counter strip -->
        <Border x:Name="InlineStatusStrip" Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,7" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TOTAL " Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource CountBrush}" FontWeight="Bold" FontSize="11" />
                <TextBlock Text="   |   IDLE " Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding IdleCount}" Foreground="{StaticResource IdleBrush}" FontWeight="Bold" FontSize="11" />
                <TextBlock Text="   |   BUSY " Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding BusyCount}" Foreground="{StaticResource BusyBrush}" FontWeight="Bold" FontSize="11" />
                <TextBlock Text="   |   OFF " Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding OffCount}" Foreground="{StaticResource OffBrush}" FontWeight="Bold" FontSize="11" />
                <TextBlock Text="   |   ERROR " Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding ErrorCount}" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold" FontSize="11" />
                <TextBlock Text="   |   TRANS " Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="{Binding TransitionCount}" Foreground="{StaticResource StartingBrush}" FontWeight="Bold" FontSize="11" />
            </StackPanel>
        </Border>

        <!-- command bar -->
        <Grid x:Name="OperationsPanel" Grid.Row="2" Margin="0,0,0,8" IsEnabled="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="FilterPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="[ ALL ]" Tag="ALL" AutomationProperties.Name="Show all runners" Style="{StaticResource TerminalButtonStyle}" Click="FilterButton_OnClick" />
                <Button Content="[ IDLE ]" Tag="IDLE" AutomationProperties.Name="Show idle runners" Style="{StaticResource TerminalButtonStyle}" Click="FilterButton_OnClick" />
                <Button Content="[ BUSY ]" Tag="BUSY" AutomationProperties.Name="Show busy runners" Style="{StaticResource TerminalButtonStyle}" Click="FilterButton_OnClick" />
                <Button Content="[ OFF ]" Tag="OFF" AutomationProperties.Name="Show off runners" Style="{StaticResource TerminalButtonStyle}" Click="FilterButton_OnClick" />
                <Button Content="[ ERROR ]" Tag="ERROR" AutomationProperties.Name="Show error runners" Style="{StaticResource TerminalButtonStyle}" Click="FilterButton_OnClick" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,8,0">
                <Button x:Name="TurnAllOnButton" AutomationProperties.Name="Turn all OFF runners on" Content="[ ALL ON ]" Click="TurnAllOnButton_OnClick" Style="{StaticResource BulkOnButtonStyle}" />
                <Button x:Name="TurnAllOffButton" AutomationProperties.Name="Stop all IDLE runners" Content="[ ALL OFF ]" Click="TurnAllOffButton_OnClick" Style="{StaticResource BulkOffButtonStyle}" />
            </StackPanel>

            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}" Height="32" Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="/" Foreground="{StaticResource RunnerBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" AutomationProperties.Name="Search runners by runner name repository or folder" TextChanged="SearchBox_OnTextChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource LabelBrush}" CaretBrush="{StaticResource RunnerBrush}" VerticalContentAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                </Grid>
            </Border>
            <Button Grid.Column="3" x:Name="ManualRefreshButton" AutomationProperties.Name="Refresh runner states now" Content="[ ↻ ]" Click="ManualRefreshButton_OnClick" Style="{StaticResource TerminalButtonStyle}" Margin="6,0,0,0" />
        </Grid>

        <!-- table is the hero -->
        <Border x:Name="RunnerTableSurface" Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="235" /><ColumnDefinition Width="*" MinWidth="180" /><ColumnDefinition Width="95" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STAT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="RUNNER" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="REPOSITORY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="STATE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="CONTROL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
                <ListView Grid.Row="1" x:Name="RunnerList" AutomationProperties.Name="Runner status table" ItemsSource="{Binding VisibleRows}" ItemContainerStyle="{StaticResource RowItemStyle}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource LabelBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40" ToolTip="{Binding DirectoryPath}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="235" /><ColumnDefinition Width="*" MinWidth="180" /><ColumnDefinition Width="95" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Opacity="{Binding AnimationIntensity}" Style="{StaticResource StateForegroundStyle}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding RunnerName}" AutomationProperties.Name="{Binding RunnerName}" Foreground="{StaticResource RunnerBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding RepositoryName}" Foreground="{StaticResource RepositoryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="3" Text="{Binding StateText}" AutomationProperties.Name="{Binding StateText}" Style="{StaticResource StateForegroundStyle}" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" />
                                <Grid Grid.Column="4" Margin="5,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button Content="{Binding ControlText}" CommandParameter="{Binding}" Click="RunnerPrimaryControl_OnClick" AutomationProperties.Name="{Binding ControlText}" Style="{StaticResource RunnerControlButtonStyle}" />
                                    <Button Grid.Column="1" Content="!" CommandParameter="{Binding}" Click="RunnerMoreControl_OnClick" AutomationProperties.Name="Force stop BUSY runner options" Style="{StaticResource RunnerMoreButtonStyle}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- external/unattributed findings never contaminate managed rows -->
        <Border x:Name="SystemFindingsPanel" Grid.Row="4" BorderBrush="{StaticResource BusyBrush}" BorderThickness="0,1,0,0" Background="#0D1319" Padding="5,7" Margin="0,5,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSystemFindings}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠ SYSTEM // " Foreground="{StaticResource BusyBrush}" FontSize="10" FontWeight="Bold" />
                <TextBlock x:Name="SystemFindingsValue" Text="{Binding SystemFindingsSummary}" ToolTip="{Binding SystemFindingsSummary}" Foreground="{StaticResource SecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- prompt-like operational footer -->
        <Border x:Name="TerminalStatusFooter" Grid.Row="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,8,2,0" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text=">" Foreground="{StaticResource RunnerBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" x:Name="RefreshStatusValue" Text="initializing runner state engine…" Foreground="{StaticResource SecondaryBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="BUSY protected // external blocked // exact-path authority" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>