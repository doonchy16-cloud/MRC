<Window x:Class="MRC.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:runtime="clr-namespace:MRC.Core.Runtime;assembly=MRC.Core"
        xmlns:controls="clr-namespace:MRC.Gui.Controls"
        Title="Main Runner Control"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#071015"
        Foreground="#F4F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#071015" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0B141B" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#111C25" />
        <SolidColorBrush x:Key="RaisedHoverBrush" Color="#172630" />
        <SolidColorBrush x:Key="BorderBrush" Color="#253542" />
        <SolidColorBrush x:Key="StrongBorderBrush" Color="#385266" />
        <SolidColorBrush x:Key="LabelBrush" Color="#F7F9FB" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#B2BDC7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#728391" />
        <SolidColorBrush x:Key="RunnerBrush" Color="#43DDF8" />
        <SolidColorBrush x:Key="RepositoryBrush" Color="#73CFE4" />
        <SolidColorBrush x:Key="MetadataBrush" Color="#8FB1CC" />
        <SolidColorBrush x:Key="CountBrush" Color="#D09AF4" />
        <SolidColorBrush x:Key="IdleBrush" Color="#35E08A" />
        <SolidColorBrush x:Key="BusyBrush" Color="#FFD166" />
        <SolidColorBrush x:Key="OffBrush" Color="#FF6474" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF934F" />
        <SolidColorBrush x:Key="StartingBrush" Color="#55AFFF" />
        <SolidColorBrush x:Key="StoppingBrush" Color="#BA92FF" />
        <SolidColorBrush x:Key="AmberActionBrush" Color="#FFC857" />
        <SolidColorBrush x:Key="AmberActionHoverBrush" Color="#FFD978" />
        <SolidColorBrush x:Key="AmberActionTextBrush" Color="#201500" />

        <Style x:Key="ApplicationButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Background" Value="#121C24" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A2934" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4B687C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.27" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        </Style>

        <Style x:Key="BulkOnButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AmberActionTextBrush}" />
            <Setter Property="BorderBrush" Value="#DDAA38" />
            <Setter Property="Background" Value="{StaticResource AmberActionBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="BulkOffButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource OffBrush}" />
            <Setter Property="BorderBrush" Value="#733541" />
            <Setter Property="Background" Value="#241318" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="CardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AmberActionTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AmberActionBrush}" />
            <Setter Property="BorderBrush" Value="#E0AE3D" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AmberActionHoverBrush}" />
                    <Setter Property="BorderBrush" Value="#FFE3A3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="#FF8A96" />
            <Setter Property="Background" Value="#201217" />
            <Setter Property="BorderBrush" Value="#7C3543" />
        </Style>

        <Style x:Key="RestartButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource RunnerBrush}" />
            <Setter Property="Background" Value="#0D1D24" />
            <Setter Property="BorderBrush" Value="#21667A" />
        </Style>

        <Style x:Key="DetailsButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Background" Value="#101820" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="ForceStopButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Background" Value="#24150D" />
            <Setter Property="BorderBrush" Value="#704525" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111C25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="MinHeight" Value="168" />
            <Setter Property="MaxHeight" Value="210" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.28" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#152630" />
                    <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}">
                    <Setter Property="Background" Value="#10221D" />
                    <Setter Property="BorderBrush" Value="#2C7553" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2AE78B" BlurRadius="18" ShadowDepth="0" Opacity="0.18" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}">
                    <Setter Property="Background" Value="#211D12" />
                    <Setter Property="BorderBrush" Value="#6F5B25" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}">
                    <Setter Property="BorderBrush" Value="#3D3D46" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}">
                    <Setter Property="BorderBrush" Value="#754020" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunnerCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StateForegroundStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}"><Setter Property="Foreground" Value="{StaticResource IdleBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}"><Setter Property="Foreground" Value="{StaticResource BusyBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}"><Setter Property="Foreground" Value="{StaticResource OffBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STARTING}"><Setter Property="Foreground" Value="{StaticResource StartingBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STOPPING}"><Setter Property="Foreground" Value="{StaticResource StoppingBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#121A23" />
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}"><Setter Property="BorderBrush" Value="#2E7A57" /><Setter Property="Background" Value="#0E2A1D" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}"><Setter Property="BorderBrush" Value="#796322" /><Setter Property="Background" Value="#2B240D" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}"><Setter Property="BorderBrush" Value="#6A303A" /><Setter Property="Background" Value="#291319" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}"><Setter Property="BorderBrush" Value="#74411F" /><Setter Property="Background" Value="#2A180D" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STARTING}"><Setter Property="BorderBrush" Value="#2B6088" /><Setter Property="Background" Value="#10283B" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STOPPING}"><Setter Property="BorderBrush" Value="#57437C" /><Setter Property="Background" Value="#211832" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CounterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0E1820" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="Margin" Value="0,0,9,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootSurface" Background="{StaticResource BackgroundBrush}">
        <controls:AmbientBackground Panel.ZIndex="0" />

        <Grid Margin="22" Panel.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:HeroHeader x:Name="HeroHeader"
                                 Grid.Row="0"
                                 Margin="2,0,2,18"
                                 MenuRequested="HeroHeader_OnMenuRequested" />

            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
                <Border Style="{StaticResource CounterCardStyle}"><StackPanel><TextBlock Text="TOTAL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource CountBrush}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Style="{StaticResource CounterCardStyle}"><StackPanel><TextBlock Text="IDLE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding IdleCount}" Foreground="{StaticResource IdleBrush}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Style="{StaticResource CounterCardStyle}"><StackPanel><TextBlock Text="BUSY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding BusyCount}" Foreground="{StaticResource BusyBrush}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Style="{StaticResource CounterCardStyle}"><StackPanel><TextBlock Text="OFF" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding OffCount}" Foreground="{StaticResource OffBrush}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Style="{StaticResource CounterCardStyle}"><StackPanel><TextBlock Text="ERROR" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding ErrorCount}" Foreground="{StaticResource ErrorBrush}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
                <Border Style="{StaticResource CounterCardStyle}" Margin="0"><StackPanel><TextBlock Text="TRANSITION" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding TransitionCount}" Foreground="{StaticResource StartingBrush}" FontSize="24" FontWeight="Bold" /></StackPanel></Border>
            </UniformGrid>

            <Grid x:Name="OperationsPanel" Grid.Row="2" Margin="0,0,0,14" IsEnabled="False">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="FilterPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="ALL" Tag="ALL" AutomationProperties.Name="Show all runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
                    <Button Content="IDLE" Tag="IDLE" AutomationProperties.Name="Show idle runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
                    <Button Content="BUSY" Tag="BUSY" AutomationProperties.Name="Show busy runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
                    <Button Content="OFF" Tag="OFF" AutomationProperties.Name="Show off runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
                    <Button Content="ERROR" Tag="ERROR" AutomationProperties.Name="Show error runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,10,0">
                    <Button x:Name="TurnAllOnButton" AutomationProperties.Name="Turn all verified OFF runners on" Content="TURN ALL ON" Click="TurnAllOnButton_OnClick" Style="{StaticResource BulkOnButtonStyle}" />
                    <Button x:Name="TurnAllOffButton" AutomationProperties.Name="Stop all verified IDLE runners" Content="TURN ALL OFF" Click="TurnAllOffButton_OnClick" Style="{StaticResource BulkOffButtonStyle}" />
                </StackPanel>

                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#0E1820" CornerRadius="9" MinHeight="38" Padding="11,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="SEARCH" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" AutomationProperties.Name="Search runners" ToolTip="Press / to focus search" TextChanged="SearchBox_OnTextChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource LabelBrush}" CaretBrush="{StaticResource RunnerBrush}" FontSize="12" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="/" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </Border>
                <Button Grid.Column="3" x:Name="ManualRefreshButton" AutomationProperties.Name="Refresh runner states now" Content="↻" Click="ManualRefreshButton_OnClick" Style="{StaticResource ApplicationButtonStyle}" Margin="7,0,0,0" MinWidth="46" />
            </Grid>

            <Border x:Name="RunnerCardSurface" Grid.Row="3" Background="#66070D12" BorderBrush="#182733" BorderThickness="1" CornerRadius="16" Padding="5" ClipToBounds="True">
                <ListBox x:Name="RunnerList"
                         AutomationProperties.Name="Managed runner command cards"
                         ItemsSource="{Binding VisibleRows}"
                         ItemContainerStyle="{StaticResource RunnerCardItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource LabelBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CardColumnCount}" IsItemsHost="True" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:RunnerControlCard Row="{Binding}"
                                                        ActionRequested="RunnerControlCard_OnActionRequested" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="SystemFindingsPanel" Grid.Row="4" Margin="0,12,0,0" Padding="12,9" Background="#101820" BorderBrush="#304253" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="SYSTEM" Foreground="{StaticResource BusyBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,11,0" />
                    <TextBlock x:Name="SystemFindingsValue" Grid.Column="1" Text="{Binding SystemFindingsSummary}" Foreground="{StaticResource SecondaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SystemFindingsSummary}" />
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="3,10,3,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="RefreshStatusValue" Text="Waiting for runner state…" Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="20 FPS UI • 3s runtime refresh" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
