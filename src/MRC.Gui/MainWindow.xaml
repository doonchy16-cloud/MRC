<Window x:Class="MRC.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:runtime="clr-namespace:MRC.Core.Runtime;assembly=MRC.Core"
        xmlns:controls="clr-namespace:MRC.Gui.Controls"
        Title="Main Runner Control"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#071015"
        Foreground="#F4F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#071015" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0B141B" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#111C25" />
        <SolidColorBrush x:Key="RaisedHoverBrush" Color="#172630" />
        <SolidColorBrush x:Key="BorderBrush" Color="#253542" />
        <SolidColorBrush x:Key="StrongBorderBrush" Color="#385266" />
        <SolidColorBrush x:Key="LabelBrush" Color="#F7F9FB" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#B2BDC7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#728391" />
        <SolidColorBrush x:Key="RunnerBrush" Color="#43DDF8" />
        <SolidColorBrush x:Key="RepositoryBrush" Color="#73CFE4" />
        <SolidColorBrush x:Key="MetadataBrush" Color="#8FB1CC" />
        <SolidColorBrush x:Key="CountBrush" Color="#D09AF4" />
        <SolidColorBrush x:Key="IdleBrush" Color="#35E08A" />
        <SolidColorBrush x:Key="BusyBrush" Color="#FFD166" />
        <SolidColorBrush x:Key="OffBrush" Color="#FF6474" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF934F" />
        <SolidColorBrush x:Key="StartingBrush" Color="#55AFFF" />
        <SolidColorBrush x:Key="StoppingBrush" Color="#BA92FF" />
        <SolidColorBrush x:Key="AmberActionBrush" Color="#FFC857" />
        <SolidColorBrush x:Key="AmberActionHoverBrush" Color="#FFD978" />
        <SolidColorBrush x:Key="AmberActionTextBrush" Color="#201500" />

        <Style x:Key="ApplicationButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Background" Value="#121C24" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A2934" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4B687C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.27" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        </Style>

        <Style x:Key="BulkOnButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AmberActionTextBrush}" />
            <Setter Property="BorderBrush" Value="#DDAA38" />
            <Setter Property="Background" Value="{StaticResource AmberActionBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="BulkOffButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource OffBrush}" />
            <Setter Property="BorderBrush" Value="#733541" />
            <Setter Property="Background" Value="#241318" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="CardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource AmberActionTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AmberActionBrush}" />
            <Setter Property="BorderBrush" Value="#E0AE3D" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AmberActionHoverBrush}" />
                    <Setter Property="BorderBrush" Value="#FFE3A3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="#FF8A96" />
            <Setter Property="Background" Value="#201217" />
            <Setter Property="BorderBrush" Value="#7C3543" />
        </Style>

        <Style x:Key="RestartButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource RunnerBrush}" />
            <Setter Property="Background" Value="#0D1D24" />
            <Setter Property="BorderBrush" Value="#21667A" />
        </Style>

        <Style x:Key="DetailsButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Background" Value="#101820" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="ForceStopButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Background" Value="#24150D" />
            <Setter Property="BorderBrush" Value="#704525" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111C25" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="MinHeight" Value="168" />
            <Setter Property="MaxHeight" Value="210" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.28" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#152630" />
                    <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}">
                    <Setter Property="Background" Value="#10221D" />
                    <Setter Property="BorderBrush" Value="#2C7553" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2AE78B" BlurRadius="18" ShadowDepth="0" Opacity="0.18" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}">
                    <Setter Property="Background" Value="#211D12" />
                    <Setter Property="BorderBrush" Value="#6F5B25" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}">
                    <Setter Property="BorderBrush" Value="#3D3D46" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}">
                    <Setter Property="BorderBrush" Value="#754020" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunnerCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StateForegroundStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}"><Setter Property="Foreground" Value="{StaticResource IdleBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}"><Setter Property="Foreground" Value="{StaticResource BusyBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}"><Setter Property="Foreground" Value="{StaticResource OffBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STARTING}"><Setter Property="Foreground" Value="{StaticResource StartingBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STOPPING}"><Setter Property="Foreground" Value="{StaticResource StoppingBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#121A23" />
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}"><Setter Property="BorderBrush" Value="#2E7A57" /><Setter Property="Background" Value="#0E2A1D" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}"><Setter Property="BorderBrush" Value="#796322" /><Setter Property="Background" Value="#2B240D" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}"><Setter Property="BorderBrush" Value="#6A303A" /><Setter Property="Background" Value="#291319" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}"><Setter Property="BorderBrush" Value="#74411F" /><Setter Property="Background" Value="#2A180D" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STARTING}"><Setter Property="BorderBrush" Value="#2B6088" /><Setter Property="Background" Value="#10283B" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STOPPING}"><Setter Property="BorderBrush" Value="#57437C" /><Setter Property="Background" Value="#211832" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CounterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0E1820" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="Margin" Value="0,0,9,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootSurface" Background="{StaticResource BackgroundBrush}">
        <controls:AmbientBackground Panel.ZIndex="0" />

        <Grid Margin="22" Panel.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:HeroHeader x:Name="HeroHeader"
                                 Grid.Row="0"
                                 Margin="2,0,2,18"
                                 MenuRequested="HeroHeader_OnMenuRequested" />

            <Border x:Name="RunnerCardSurface" Grid.Row="1" Background="Transparent" BorderBrush="#182733" BorderThickness="0" CornerRadius="16" Padding="5" ClipToBounds="True">
                <ListBox x:Name="RunnerList"
                         AutomationProperties.Name="Managed runner command cards"
                         ItemsSource="{Binding VisibleRows}"
                         ItemContainerStyle="{StaticResource RunnerCardItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource LabelBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DarkScrollBarStyle}" />
                    </ListBox.Resources>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CardColumnCount}" IsItemsHost="True" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:RunnerControlCard Row="{Binding}"
                                                        ActionRequested="RunnerControlCard_OnActionRequested" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ToggleButton x:Name="SystemFindingsPanel"
                          Grid.Row="2"
                          Margin="0,12,0,0"
                          Padding="12,9"
                          Background="#101820"
                          BorderBrush="#304253"
                          BorderThickness="1"
                          Foreground="{StaticResource SecondaryBrush}"
                          HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="Toggle read-only system evidence drawer"
                          ToolTip="Open read-only external and unattributed system evidence">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#765624" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A7782B" />
                                <Setter TargetName="Chrome" Property="Background" Value="#161B19" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="SYSTEM" Foreground="{StaticResource BusyBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,11,0" />
                    <TextBlock x:Name="SystemFindingsValue" Grid.Column="1" Text="{Binding SystemFindingsSummary}" Foreground="{StaticResource SecondaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SystemFindingsSummary}" />
                    <TextBlock Grid.Column="2" Text="DETAILS ▴" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="9" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </ToggleButton>

            <Grid Grid.Row="3" Margin="3,10,3,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="RefreshStatusValue" Text="Waiting for runner state…" Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="20 FPS UI • 3s runtime refresh" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Grid>

        <Button x:Name="DrawerScrim"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                Background="#99000000"
                BorderThickness="0"
                Focusable="False"
                Click="DrawerScrim_OnClick" />

        <Border x:Name="ControlDrawerHost"
                Panel.ZIndex="11"
                Width="400"
                Margin="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
            <controls:ControlDrawer x:Name="ControlDrawer"
                                    TurnAllOnRequested="TurnAllOnButton_OnClick"
                                    TurnAllOffRequested="TurnAllOffButton_OnClick"
                                    RefreshRequested="ManualRefreshButton_OnClick" />
        </Border>

        <Border x:Name="SystemDrawerHost"
                Panel.ZIndex="12"
                Margin="16,16,16,54"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=SystemFindingsPanel}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <controls:SystemDrawer x:Name="SystemDrawer"
                                   StatusText="{Binding Text, ElementName=RefreshStatusValue}" />
        </Border>
    </Grid>
</Window>