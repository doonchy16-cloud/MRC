<Window x:Class="MRC.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:runtime="clr-namespace:MRC.Core.Runtime;assembly=MRC.Core"
        Title="Main Runner Control"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#080D12"
        Foreground="#F4F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#080D12" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D141C" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#111B25" />
        <SolidColorBrush x:Key="RaisedHoverBrush" Color="#152330" />
        <SolidColorBrush x:Key="BorderBrush" Color="#223141" />
        <SolidColorBrush x:Key="StrongBorderBrush" Color="#30465B" />
        <SolidColorBrush x:Key="LabelBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#AAB6C3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#708091" />
        <SolidColorBrush x:Key="RunnerBrush" Color="#35D9FF" />
        <SolidColorBrush x:Key="RepositoryBrush" Color="#76CFE8" />
        <SolidColorBrush x:Key="MetadataBrush" Color="#8BAFD1" />
        <SolidColorBrush x:Key="CountBrush" Color="#C792EA" />
        <SolidColorBrush x:Key="IdleBrush" Color="#39E58C" />
        <SolidColorBrush x:Key="BusyBrush" Color="#FFD166" />
        <SolidColorBrush x:Key="OffBrush" Color="#FF6676" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A3D" />
        <SolidColorBrush x:Key="StartingBrush" Color="#4CA7FF" />
        <SolidColorBrush x:Key="StoppingBrush" Color="#B48CFF" />

        <Style x:Key="ApplicationButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Background" Value="#111A23" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#172431" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3A5269" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.34" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        </Style>

        <Style x:Key="BulkOnButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource IdleBrush}" />
            <Setter Property="BorderBrush" Value="#24563E" />
            <Setter Property="Background" Value="#0D2118" />
        </Style>

        <Style x:Key="BulkOffButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource OffBrush}" />
            <Setter Property="BorderBrush" Value="#5E2A32" />
            <Setter Property="Background" Value="#241116" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="CardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationButtonStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource IdleBrush}" />
            <Setter Property="BorderBrush" Value="#24563E" />
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource OffBrush}" />
            <Setter Property="BorderBrush" Value="#5E2A32" />
        </Style>

        <Style x:Key="RestartButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource RunnerBrush}" />
            <Setter Property="BorderBrush" Value="#20566A" />
        </Style>

        <Style x:Key="DetailsButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="ForceStopButtonStyle" TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="BorderBrush" Value="#6B3D20" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="MinHeight" Value="108" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RaisedHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RunnerCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StateForegroundStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}"><Setter Property="Foreground" Value="{StaticResource IdleBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}"><Setter Property="Foreground" Value="{StaticResource BusyBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}"><Setter Property="Foreground" Value="{StaticResource OffBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STARTING}"><Setter Property="Foreground" Value="{StaticResource StartingBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STOPPING}"><Setter Property="Foreground" Value="{StaticResource StoppingBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#121A23" />
            <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.IDLE}"><Setter Property="BorderBrush" Value="#24563E" /><Setter Property="Background" Value="#0D2118" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.BUSY}"><Setter Property="BorderBrush" Value="#66552A" /><Setter Property="Background" Value="#251F0E" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.OFF}"><Setter Property="BorderBrush" Value="#5E2A32" /><Setter Property="Background" Value="#241116" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.ERROR}"><Setter Property="BorderBrush" Value="#6B3D20" /><Setter Property="Background" Value="#26170E" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STARTING}"><Setter Property="BorderBrush" Value="#28577C" /><Setter Property="Background" Value="#102338" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static runtime:RunnerState.STOPPING}"><Setter Property="BorderBrush" Value="#4D3C70" /><Setter Property="Background" Value="#1D1730" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CounterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootSurface" Background="{StaticResource BackgroundBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MAIN RUNNER CONTROL" FontSize="28" FontWeight="Bold" Foreground="{StaticResource LabelBrush}" />
                    <Border Margin="12,2,0,0" Padding="9,3" Background="#0D2118" BorderBrush="#24563E" BorderThickness="1" CornerRadius="999" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="BoundaryDot" Width="8" Height="8" Fill="{StaticResource IdleBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="BoundaryValue" Text="AUTHORIZED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource IdleBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="1,5,0,0">
                    <TextBlock Text="HOST" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="MachineValue" Margin="7,0,18,0" Foreground="{StaticResource RunnerBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="ROOT" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="RootValue" Margin="7,0,0,0" Foreground="{StaticResource MetadataBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="VersionValue" Grid.Column="1" Text="PRE-CERT" Foreground="{StaticResource CountBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" Margin="12,6,0,0" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,12">
            <Border Style="{StaticResource CounterCardStyle}">
                <StackPanel><TextBlock Text="TOTAL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource CountBrush}" FontSize="20" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CounterCardStyle}">
                <StackPanel><TextBlock Text="IDLE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding IdleCount}" Foreground="{StaticResource IdleBrush}" FontSize="20" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CounterCardStyle}">
                <StackPanel><TextBlock Text="BUSY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding BusyCount}" Foreground="{StaticResource BusyBrush}" FontSize="20" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CounterCardStyle}">
                <StackPanel><TextBlock Text="OFF" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding OffCount}" Foreground="{StaticResource OffBrush}" FontSize="20" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CounterCardStyle}">
                <StackPanel><TextBlock Text="ERROR" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding ErrorCount}" Foreground="{StaticResource ErrorBrush}" FontSize="20" FontWeight="Bold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CounterCardStyle}" Margin="0">
                <StackPanel><TextBlock Text="TRANSITION" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="{Binding TransitionCount}" Foreground="{StaticResource StartingBrush}" FontSize="20" FontWeight="Bold" /></StackPanel>
            </Border>
        </UniformGrid>

        <Grid x:Name="OperationsPanel" Grid.Row="2" Margin="0,0,0,10" IsEnabled="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="160" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="FilterPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="ALL" Tag="ALL" AutomationProperties.Name="Show all runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
                <Button Content="IDLE" Tag="IDLE" AutomationProperties.Name="Show idle runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
                <Button Content="BUSY" Tag="BUSY" AutomationProperties.Name="Show busy runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
                <Button Content="OFF" Tag="OFF" AutomationProperties.Name="Show off runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
                <Button Content="ERROR" Tag="ERROR" AutomationProperties.Name="Show error runners" Style="{StaticResource FilterButtonStyle}" Click="FilterButton_OnClick" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,8,0">
                <Button x:Name="TurnAllOnButton" AutomationProperties.Name="Turn all verified OFF runners on" Content="TURN ALL ON" Click="TurnAllOnButton_OnClick" Style="{StaticResource BulkOnButtonStyle}" />
                <Button x:Name="TurnAllOffButton" AutomationProperties.Name="Stop all verified IDLE runners" Content="TURN ALL OFF" Click="TurnAllOffButton_OnClick" Style="{StaticResource BulkOffButtonStyle}" />
            </StackPanel>

            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}" CornerRadius="8" MinHeight="34" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="SEARCH" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" AutomationProperties.Name="Search runners" ToolTip="Press / to focus search" TextChanged="SearchBox_OnTextChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource LabelBrush}" CaretBrush="{StaticResource RunnerBrush}" FontSize="12" VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="/" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>
            <Button Grid.Column="3" x:Name="ManualRefreshButton" AutomationProperties.Name="Refresh runner states now" Content="↻" Click="ManualRefreshButton_OnClick" Style="{StaticResource ApplicationButtonStyle}" Margin="6,0,0,0" MinWidth="42" />
        </Grid>

        <Border x:Name="RunnerCardSurface" Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="6" ClipToBounds="True">
            <ListBox x:Name="RunnerList"
                     AutomationProperties.Name="Managed runner command cards"
                     ItemsSource="{Binding VisibleRows}"
                     ItemContainerStyle="{StaticResource RunnerCardItemStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource LabelBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding CardColumnCount}" IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RunnerCardStyle}" ToolTip="{Binding DirectoryPath}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" Background="#0A1118" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Glyph}" Opacity="{Binding AnimationIntensity}" Style="{StaticResource StateForegroundStyle}" FontFamily="Cascadia Mono, Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RunnerName}" AutomationProperties.Name="{Binding RunnerName}" Foreground="{StaticResource LabelBrush}" TextTrimming="CharacterEllipsis" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RepositoryName}" Foreground="{StaticResource RepositoryBrush}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,2,8,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StateBadgeStyle}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StateText}" AutomationProperties.Name="{Binding StateText}" Style="{StaticResource StateForegroundStyle}" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="START" CommandParameter="{Binding}" IsEnabled="{Binding CanStart}" Click="RunnerStart_OnClick" AutomationProperties.Name="Start runner" Style="{StaticResource StartButtonStyle}" />
                                    <Button Grid.Column="1" Content="STOP" CommandParameter="{Binding}" IsEnabled="{Binding CanStop}" Click="RunnerStop_OnClick" AutomationProperties.Name="Stop runner" Style="{StaticResource StopButtonStyle}" />
                                    <Button Grid.Column="2" Content="RESTART" CommandParameter="{Binding}" IsEnabled="{Binding CanRestart}" Click="RunnerRestart_OnClick" AutomationProperties.Name="Restart runner" Style="{StaticResource RestartButtonStyle}" />
                                    <Button Grid.Column="3" Content="DETAILS" CommandParameter="{Binding}" IsEnabled="{Binding CanShowDetails}" Click="RunnerDetails_OnClick" AutomationProperties.Name="Open runner diagnostics" Style="{StaticResource DetailsButtonStyle}" />
                                    <Button Grid.Column="5" Content="FORCE STOP" CommandParameter="{Binding}" Click="RunnerMoreControl_OnClick" AutomationProperties.Name="Force stop BUSY runner" Style="{StaticResource ForceStopButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border x:Name="SystemFindingsPanel" Grid.Row="4" Margin="0,10,0,0" Padding="10,8" Background="#10171F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="SYSTEM" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="SystemFindingsValue" Grid.Column="1" Text="{Binding SystemFindingsSummary}" Foreground="{StaticResource SecondaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SystemFindingsSummary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="2,9,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="RefreshStatusValue" Text="Waiting for runner state…" Foreground="{StaticResource SecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="20 FPS UI • 3s runtime refresh" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Window>