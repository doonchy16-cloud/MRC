<Window x:Class="MRC.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Runner Control"
        Width="760"
        Height="420"
        MinWidth="640"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14"
        Foreground="#F4F7FA">
    <Grid Margin="28">
        <Border Background="#111821" BorderBrush="#263342" BorderThickness="1" CornerRadius="8" Padding="24">
            <StackPanel>
                <TextBlock Text="MAIN RUNNER CONTROL" FontSize="24" FontWeight="SemiBold" Foreground="#F4F7FA" />
                <TextBlock Text="PASS 1 FOUNDATION" Margin="0,4,0,24" FontSize="12" Foreground="#74A9D8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Machine" Margin="0,0,12,12" Foreground="#AAB6C3" />
                    <TextBlock x:Name="MachineValue" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Foreground="#35D9FF" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Runner root" Margin="0,0,12,12" Foreground="#AAB6C3" />
                    <TextBlock x:Name="RootValue" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Foreground="#74A9D8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Boundary" Margin="0,0,12,0" Foreground="#AAB6C3" />
                    <TextBlock x:Name="BoundaryValue" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" />
                </Grid>

                <Border Margin="0,24,0,0" Padding="14" Background="#18212B" BorderBrush="#263342" BorderThickness="1" CornerRadius="5">
                    <TextBlock x:Name="DetailsValue" TextWrapping="Wrap" Foreground="#AAB6C3" />
                </Border>

                <TextBlock Margin="0,18,0,0"
                           Text="Runner discovery and controls are intentionally not implemented in PASS 1."
                           Foreground="#667381"
                           FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
