<UserControl x:Class="MRC.Gui.Controls.SystemDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="SystemDrawerCloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D6DDE1" />
            <Setter Property="Background" Value="#11181C" />
            <Setter Property="BorderBrush" Value="#765624" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#161B19" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A7782B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FF0B1013"
            BorderBrush="#765624"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SYSTEM EVIDENCE"
                               Foreground="#F5F7F9"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="EXTERNAL + UNATTRIBUTED • READ ONLY"
                               Foreground="#FCC34C"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#11181C"
                            BorderBrush="#354248"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,5"
                            Margin="0,0,8,0">
                        <TextBlock FontFamily="Cascadia Mono, Consolas"
                                   FontSize="9"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="CLEAR" />
                                    <Setter Property="Foreground" Value="#8D969B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSystemFindings}" Value="True">
                                            <Setter Property="Text" Value="EVIDENCE PRESENT" />
                                            <Setter Property="Foreground" Value="#FFD166" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button x:Name="CloseButton"
                            Content="CLOSE"
                            Style="{StaticResource SystemDrawerCloseButtonStyle}"
                            ToolTip="Close system evidence drawer"
                            Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="#B512181C"
                    BorderBrush="#354248"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <TextBlock Text="{Binding SystemFindingsSummary}"
                           Foreground="#D6DDE1"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10"
                           TextWrapping="Wrap" />
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource DarkScrollBarStyle}" />
                </ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding SystemFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#D90E1519"
                                    BorderBrush="#2F3C43"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}"
                                                   Foreground="#FFD166"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProcessName}"
                                                   Foreground="#F5F7F9"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="PID " Foreground="#8D969B" FontFamily="Cascadia Mono, Consolas" FontSize="9" />
                                        <TextBlock Text="{Binding ProcessId}" Foreground="#D6DDE1" FontFamily="Cascadia Mono, Consolas" FontSize="9" Margin="0,0,12,0" />
                                        <TextBlock Text="PARENT " Foreground="#8D969B" FontFamily="Cascadia Mono, Consolas" FontSize="9" />
                                        <TextBlock Text="{Binding ParentProcessId}" Foreground="#D6DDE1" FontFamily="Cascadia Mono, Consolas" FontSize="9" Margin="0,0,12,0" />
                                        <TextBlock Text="SESSION " Foreground="#8D969B" FontFamily="Cascadia Mono, Consolas" FontSize="9" />
                                        <TextBlock Text="{Binding SessionId}" Foreground="#D6DDE1" FontFamily="Cascadia Mono, Consolas" FontSize="9" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding ExecutablePath, TargetNullValue=PATH UNKNOWN}"
                                               Foreground="#8D969B"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"
                                               ToolTip="{Binding ExecutablePath}" />
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding Message}"
                                               Foreground="#BFC8CD"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Background="#11181C"
                    BorderBrush="#2F3C43"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="11,8"
                    Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="STATUS"
                               Foreground="#8D969B"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="9"
                               FontWeight="Bold"
                               Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText, ElementName=Root}"
                               Foreground="#D6DDE1"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="9"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
