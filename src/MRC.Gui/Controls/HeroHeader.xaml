<UserControl x:Class="MRC.Gui.Controls.HeroHeader"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Foreground="{DynamicResource ReplicaHeroWhiteBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MRC.Gui;component/Themes/ReferenceReplica.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="HeroIdentityCluster"
                    Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Button x:Name="MenuButton"
                    Width="58"
                    Height="58"
                    Padding="0"
                    Margin="0,0,18,0"
                    Content="☰"
                    FontFamily="Segoe UI Symbol"
                    FontSize="23"
                    FontWeight="Bold"
                    Foreground="#241A08"
                    Background="{StaticResource ReplicaAmberBrush}"
                    BorderBrush="#FFD77B"
                    BorderThickness="1"
                    Cursor="Hand"
                    AutomationProperties.Name="Open runner control drawer"
                    Click="Menu_OnClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFF0B5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.80" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MAIN PC • LOCAL-FIRST CONTROL"
                           Foreground="{StaticResource ReplicaMutedBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="2,0,0,2" />
                <TextBlock Text="MAIN RUNNER CONTROL"
                           Foreground="{StaticResource ReplicaHeroWhiteBrush}"
                           FontSize="52"
                           FontWeight="Bold"
                           LineHeight="54" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="HeroTruthCluster"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="MinWidth" Value="300" />
                    <Setter Property="Margin" Value="28,0,0,0" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Margin" Value="76,10,0,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border x:Name="LiveInventoryPill"
                    Padding="15,8"
                    CornerRadius="999"
                    BorderThickness="1"
                    HorizontalAlignment="Right">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#2A160D" />
                        <Setter Property="BorderBrush" Value="#7A3F24" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Authorized, ElementName=Root}" Value="True">
                                <Setter Property="Background" Value="#102A1E" />
                                <Setter Property="BorderBrush" Value="#24734F" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding InventoryText, ElementName=Root}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="11"
                           FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource ReplicaErrorBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Authorized, ElementName=Root}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ReplicaIdleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <TextBlock Text="{Binding TruthText, ElementName=Root}"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource ReplicaMutedBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="10" />
            <TextBlock Text="{Binding VersionText, ElementName=Root}"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Right"
                       Foreground="#D09AF4"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="11"
                       FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</UserControl>
